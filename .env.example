# KayJob - Neon PostgreSQL
# Copie ce fichier en .env puis colle l'URL de connexion Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
NEON_AUTH_BASE_URL="https://HOST.neonauth.REGION.aws.neon.tech/DBNAME/auth"
NEON_ORG_ID="org-soft-butterfly-66716723"
NEON_PROJECT_ID="green-smoke-94867582"

# Variables compatibles Laravel si tu ne veux pas utiliser DATABASE_URL directement.
DB_CONNECTION=pgsql
DB_HOST="HOST-pooler.REGION.aws.neon.tech"
DB_PORT=5432
DB_DATABASE="DBNAME"
DB_USERNAME="USER"
DB_PASSWORD="PASSWORD"
DB_SSLMODE=require

APP_ENV=local
APP_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
