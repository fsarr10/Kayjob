# KayJob - Neon PostgreSQL
# Copie ce fichier en .env puis colle l'URL de connexion Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Variables compatibles Laravel si tu ne veux pas utiliser DATABASE_URL directement.
DB_CONNECTION=pgsql
DB_HOST="HOST.neon.tech"
DB_PORT=5432
DB_DATABASE="DBNAME"
DB_USERNAME="USER"
DB_PASSWORD="PASSWORD"
DB_SSLMODE=require

# Futur backend/API
APP_ENV=local
APP_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
